{
  "name": "hermes-remote",
  "description": "Remote CLI for managing a Hermes Agent deployment over REST — cron jobs, env, status, model. Works against any Hermes instance (Coolify, bare VPS, etc.).",
  "version": "0.4.0",
  "agent_plus_version": ">=0.7",
  "refresh_handler": {
    "command": "hermes-remote whoami --json",
    "timeout_seconds": 10,
    "identity_keys": ["base_url", "env_user"],
    "failure_mode": "soft"
  },
  "author": {
    "name": "Oliver Southgate",
    "url": "https://github.com/osouthgate"
  },
  "homepage": "https://github.com/osouthgate/agent-plus-skills",
  "repository": "https://github.com/osouthgate/agent-plus-skills",
  "license": "MIT",
  "keywords": ["hermes", "hermes-agent", "nous-research", "remote", "cli", "cron"]
}
