#!/usr/bin/env python3
"""coolify-remote — CLI for managing a Coolify instance over its REST API.

Collapses the common Coolify fumbles into one-liners:

  - Resolves apps by name (no UUID threading through call chains)
  - Sends the correct field names (`domains`, not `fqdn`) with client-side validation
  - `deploy --wait` polls to completion instead of hand-rolled `until` loops
  - `env set --verify` reads vars back after writing to catch silent no-ops
  - `tls enable` bundles domain + force_https + deploy + cert smoke test
  - No shell heredocs, no temp files — JSON parsed in-process (works on Windows)

Configuration (highest precedence first):
  1. --env-file <path>
  2. ./.env.local, ./.env   (walked up from cwd)
  3. Shell environment       (including Claude Code settings)

Project .env files WIN over the shell — drop a .env in your repo and it
overrides whatever globals you have set, no unset required.

Env vars read:
  COOLIFY_URL          e.g. http://1.2.3.4:8000 or https://coolify.example.com
  COOLIFY_API_KEY      Bearer token from Coolify → Keys & Tokens

For `app exec` (SSH-based, since Coolify has no REST exec endpoint):
  COOLIFY_SSH_HOST     override for the SSH target (default: host parsed from COOLIFY_URL)
  COOLIFY_SSH_USER     SSH user (default: root)
  COOLIFY_SSH_KEY      SSH private key path (default: ssh's own defaults / agent)
  COOLIFY_SSH_PORT     SSH port (default: 22)

Python 3.9+, stdlib only.
"""

from __future__ import annotations

import argparse
import functools
import json
import os
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

# Deployment-wait constants. MIN_POLL_INTERVAL clamps user input so an
# agent can't accidentally DDoS the Coolify API with poll_interval=0.
WAIT_DEFAULT_TIMEOUT = 600
WAIT_DEFAULT_POLL_INTERVAL = 3
WAIT_MIN_POLL_INTERVAL = 2

# Fields projected from the raw Coolify deployment record into wait-result
# envelopes. Excludes `logs` because build logs can echo env-var values
# and we don't want to leak those into the agent's context window. The
# `deployment logs <uuid>` subcommand is the deliberate path to opt-in to
# log retrieval.
_DEPLOY_SAFE_FIELDS = (
    "uuid", "status", "status_reason",
    "created_at", "updated_at", "finished_at",
    "commit", "commit_message", "branch", "git_type",
    "application_id", "application_uuid", "deployment_url",
    "is_webhook", "is_redeploy", "is_pr",
)


def _slim_deployment(dep_record: dict) -> dict:
    """Project a Coolify deployment record to safe fields only.

    Drops `logs` (may contain env vars echoed during build) and any other
    field not on the allowlist. Returns an empty dict if input isn't a dict.
    """
    if not isinstance(dep_record, dict):
        return {}
    return {k: dep_record[k] for k in _DEPLOY_SAFE_FIELDS if k in dep_record}


# ─── tool identity ────────────────────────────────────────────────────────────
# Every JSON payload this tool emits carries a top-level `tool: {name, version}`
# field so agents can self-diagnose version drift from the output alone — no
# extra subprocess call needed. Version is read from the plugin manifest at
# runtime so bumping plugin.json automatically flows through here.

TOOL_NAME = "coolify-remote"


@functools.lru_cache(maxsize=1)
def _plugin_version() -> str:
    """Read the plugin version from `.claude-plugin/plugin.json` relative to
    this file. Returns 'unknown' on any error — never raises."""
    try:
        manifest = Path(__file__).resolve().parent.parent / ".claude-plugin" / "plugin.json"
        data = json.loads(manifest.read_text(encoding="utf-8"))
        return str(data.get("version", "unknown"))
    except (OSError, json.JSONDecodeError):
        return "unknown"


def _tool_meta() -> dict[str, str]:
    return {"name": TOOL_NAME, "version": _plugin_version()}


def _with_tool_meta(payload: Any) -> Any:
    """Inject `tool: {name, version}` at the top of a dict payload. Pass-through
    for non-dict payloads (list, str, None) so single-value responses stay the
    shape they were."""
    if isinstance(payload, dict) and "tool" not in payload:
        return {"tool": _tool_meta(), **payload}
    return payload

# ─── .env autoloading ─────────────────────────────────────────────────────────

_ENV_FILENAMES = (".env.local", ".env")
_ENV_PREFIXES = ("COOLIFY_",)


def _parse_env_file(path: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    try:
        text = path.read_text(encoding="utf-8")
    except Exception:
        return out
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export ") :].lstrip()
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in ("'", '"'):
            v = v[1:-1]
        if k:
            out[k] = v
    return out


def _autoload_env_files(extra: list[str] | None = None) -> list[Path]:
    """Populate os.environ from .env files. Project files override the shell
    for COOLIFY_* keys.

    Precedence (highest first): --env-file, then project .env.local, then
    project .env, then shell. Candidates collected high-to-low, then applied
    low-to-high so each higher-priority file overwrites on top.
    """
    candidates: list[Path] = []
    seen: set[Path] = set()

    def _push(p: Path) -> None:
        p = p.expanduser().resolve()
        if p in seen or not p.is_file():
            return
        seen.add(p)
        candidates.append(p)

    for f in extra or []:
        _push(Path(f))

    cwd = Path.cwd().resolve()
    for parent in (cwd, *cwd.parents):
        before = len(candidates)
        for name in _ENV_FILENAMES:
            _push(parent / name)
        if len(candidates) > before:
            break

    loaded: list[Path] = []
    for p in reversed(candidates):
        vals = _parse_env_file(p)
        any_taken = False
        for k, v in vals.items():
            if not k.startswith(_ENV_PREFIXES):
                continue
            os.environ[k] = v
            any_taken = True
        if any_taken:
            loaded.append(p)
    return loaded


def _suggest_env_setup(missing: str) -> str:
    cwd = Path.cwd()
    return (
        f"{missing}\n\n"
        "Set these in whichever is most convenient — project files win over shell env:\n\n"
        f"  Project-level (preferred):  {cwd / '.env'}\n"
        "    # .env\n"
        "    COOLIFY_URL=https://coolify.example.com\n"
        "    COOLIFY_API_KEY=...\n\n"
        "  Global (Claude Code settings):\n"
        "    ~/.claude/settings.json → \"env\": { \"COOLIFY_URL\": \"...\", \"COOLIFY_API_KEY\": \"...\" }\n"
        "    (or export them in your shell profile)\n"
    )


# ─── transport ────────────────────────────────────────────────────────────────


class CoolifyClient:
    def __init__(self) -> None:
        url = os.environ.get("COOLIFY_URL", "").rstrip("/")
        key = os.environ.get("COOLIFY_API_KEY", "")
        if not url or not key:
            raise SystemExit(_suggest_env_setup(
                "COOLIFY_URL and COOLIFY_API_KEY must both be set."
            ))
        self.base_url = url
        self.api_key = key

    def call(
        self,
        method: str,
        path: str,
        body: Any = None,
        *,
        query: dict[str, Any] | None = None,
        timeout: float = 60.0,
    ) -> tuple[int, Any]:
        url = f"{self.base_url}{path}"
        if query:
            url += "?" + urllib.parse.urlencode({k: v for k, v in query.items() if v is not None})
        headers = {
            "Authorization": f"Bearer {self.api_key}",
            "Accept": "application/json",
        }
        data: bytes | None = None
        if body is not None:
            data = json.dumps(body).encode()
            headers["Content-Type"] = "application/json"
        req = urllib.request.Request(url, data=data, headers=headers, method=method)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                raw = resp.read()
                status = resp.status
        except urllib.error.HTTPError as e:
            raw = e.read()
            status = e.code
        try:
            parsed = json.loads(raw) if raw else None
        except json.JSONDecodeError:
            parsed = raw
        return status, parsed

    # ── app resolution ────────────────────────────────────────────────────────

    def _apps(self) -> list[dict]:
        status, data = self.call("GET", "/api/v1/applications")
        if status >= 300 or not isinstance(data, list):
            raise SystemExit(f"GET /api/v1/applications failed: HTTP {status}: {data!r}")
        return data

    def resolve_app(self, ident: str) -> dict:
        """Find an app by name or UUID. Returns the full app record."""
        apps = self._apps()
        # Exact UUID match first (cheap).
        for a in apps:
            if a.get("uuid") == ident:
                return a
        # Exact name match.
        for a in apps:
            if a.get("name") == ident:
                return a
        # FQDN substring (occasionally useful).
        for a in apps:
            fqdn = a.get("fqdn") or ""
            if ident in fqdn:
                return a
        names = ", ".join(sorted(a.get("name", "?") for a in apps)) or "(none)"
        raise SystemExit(f"No app matching {ident!r}. Known apps: {names}")


# ─── pretty printers ──────────────────────────────────────────────────────────


def _dump_json(obj: Any) -> None:
    wrapped = _with_tool_meta(obj)
    json.dump(wrapped, sys.stdout, indent=2, sort_keys=True, default=str)
    sys.stdout.write("\n")


def _print_app_row(a: dict) -> None:
    fqdn = (a.get("fqdn") or "").split(",")[0].strip() or "-"
    status = a.get("status") or "?"
    print(f"  {a.get('name',''):24s} {status:22s} {fqdn}")


# ─── subcommands ──────────────────────────────────────────────────────────────


def cmd_app_list(client: CoolifyClient, args: argparse.Namespace) -> None:
    apps = client._apps()
    if args.json:
        _dump_json(apps)
        return
    print(f"{len(apps)} application(s):")
    print(f"  {'name':24s} {'status':22s} fqdn")
    for a in sorted(apps, key=lambda x: x.get("name", "")):
        _print_app_row(a)


def cmd_app_show(client: CoolifyClient, args: argparse.Namespace) -> None:
    app = client.resolve_app(args.app)
    # Re-fetch by UUID to get the full record (list endpoint may summarise).
    status, full = client.call("GET", f"/api/v1/applications/{app['uuid']}")
    _dump_json(full if status < 300 else app)


def _resolve_ssh_host() -> str:
    """Figure out where to SSH. Priority: COOLIFY_SSH_HOST explicit override →
    hostname/IP parsed from COOLIFY_URL. Fails with a useful hint otherwise.

    Coolify has no REST exec endpoint (`/applications/{uuid}/execute` et al
    return 404). The web UI uses a WebSocket terminal; we take the simpler
    path and shell out to `ssh host 'docker exec …'`. For single-VPS setups
    (is_coolify_host=true) this is the same box hosting the workload anyway.
    """
    explicit = os.environ.get("COOLIFY_SSH_HOST", "").strip()
    if explicit:
        return explicit
    url = os.environ.get("COOLIFY_URL", "")
    if url:
        try:
            parsed = urllib.parse.urlparse(url)
            if parsed.hostname:
                return parsed.hostname
        except Exception:
            pass
    raise SystemExit(
        "Cannot determine SSH host. Set COOLIFY_SSH_HOST explicitly, or make "
        "sure COOLIFY_URL contains a real hostname/IP (not 'host.docker.internal')."
    )


def cmd_app_exec(client: CoolifyClient, args: argparse.Namespace) -> None:
    """Run a shell command inside the app's running Docker container.

    Implementation: SSH to the Coolify host and `docker exec` into the
    container Coolify tagged with the app's UUID. Needs ssh on PATH and
    a working key-based connection to the host (no password prompts).
    """
    # argparse.REMAINDER keeps the leading `--` sentinel in args.command;
    # strip it so we don't forward it to `sh -c` as a no-op argument.
    if args.command and args.command[0] == "--":
        args.command = args.command[1:]
    if not args.command:
        raise SystemExit(
            "No command given. Pass it after --, e.g.\n"
            "  coolify-remote app exec hermes -- ls /data"
        )

    app = client.resolve_app(args.app)
    uuid = app["uuid"]
    host = _resolve_ssh_host()
    user = os.environ.get("COOLIFY_SSH_USER", "root")
    port = os.environ.get("COOLIFY_SSH_PORT", "22")
    key = os.environ.get("COOLIFY_SSH_KEY", "").strip()

    # Compose the remote-side command. Find the container by name prefix
    # (Coolify names running containers `<app-uuid>-<timestamp>`), pick the
    # newest if a blue/green rollout has more than one matching, then
    # docker exec into it. Exits:
    #   0 — exec ran (remote command's exit code is propagated by docker exec)
    #   2 — no running container for this app
    #   3 — more than one matching container; picked newest but warned
    # The sort-by-CreatedAt + head is deterministic across Docker versions:
    # `docker ps` shows newest first by default, but we sort explicitly so a
    # future change to that default doesn't silently flip which container
    # `app exec` targets.
    user_cmd = " ".join(shlex.quote(a) for a in args.command)
    docker_flags = "-i" + ("t" if args.tty else "")
    remote = (
        f"MATCHES=$(docker ps --filter name={shlex.quote(uuid)} "
        f"--format '{{{{.CreatedAt}}}}\\t{{{{.ID}}}}' | sort -r); "
        f'if [ -z "$MATCHES" ]; then '
        f'echo "coolify-remote: no running container found for app {uuid}" >&2; exit 2; '
        f"fi; "
        f'COUNT=$(echo "$MATCHES" | wc -l | tr -d " "); '
        f'CID=$(echo "$MATCHES" | head -n1 | cut -f2); '
        f'if [ "$COUNT" -gt 1 ]; then '
        f'echo "coolify-remote: WARNING $COUNT containers match app {uuid}; running against newest ($CID)" >&2; '
        f"fi; "
        f"docker exec {docker_flags} \"$CID\" sh -c {shlex.quote(user_cmd)}"
    )

    ssh_cmd = ["ssh"]
    if args.tty:
        ssh_cmd.append("-t")
    ssh_cmd += ["-p", port]
    if key:
        ssh_cmd += ["-i", key]
    # `accept-new` by default so first-contact doesn't hang a cron on the
    # interactive fingerprint prompt. It still refuses on mismatch, so host
    # key rotation is caught. Escape hatch: --ssh-strict (maps to default
    # StrictHostKeyChecking=ask, for when you want to be paranoid).
    if not args.ssh_strict:
        ssh_cmd += ["-o", "StrictHostKeyChecking=accept-new"]
    # Silence the "Warning: Permanently added ... to known hosts" noise for
    # cron-style use; user can override with --verbose.
    if not args.verbose:
        ssh_cmd += ["-o", "LogLevel=ERROR"]
    ssh_cmd += [f"{user}@{host}", remote]

    if args.verbose:
        print(f"→ {' '.join(shlex.quote(a) for a in ssh_cmd)}", file=sys.stderr)

    try:
        result = subprocess.run(ssh_cmd)
    except FileNotFoundError:
        raise SystemExit("ssh not found on PATH")
    sys.exit(result.returncode)


def cmd_env_list(client: CoolifyClient, args: argparse.Namespace) -> None:
    app = client.resolve_app(args.app)
    status, data = client.call("GET", f"/api/v1/applications/{app['uuid']}/envs")
    if status >= 300:
        raise SystemExit(f"GET envs failed: HTTP {status}: {data!r}")
    if args.json:
        _dump_json(data)
        return
    if not isinstance(data, list):
        _dump_json(data)
        return
    for e in sorted(data, key=lambda x: x.get("key", "")):
        key = e.get("key", "")
        val = e.get("value", "")
        if val and len(val) > 12 and not args.show:
            val = val[:4] + "…" + val[-4:]
        preview = " [preview]" if e.get("is_preview") else ""
        print(f"  {key:32s} {val}{preview}")


def _parse_kv_pairs(pairs: list[str]) -> dict[str, str]:
    out: dict[str, str] = {}
    for p in pairs:
        if "=" not in p:
            raise SystemExit(f"Expected KEY=VALUE, got: {p!r}")
        k, v = p.split("=", 1)
        out[k.strip()] = v
    return out


def _upsert_env(client: CoolifyClient, app_uuid: str, key: str, value: str, is_preview: bool) -> int:
    """POST new env; if it already exists (409/422), PATCH it."""
    payload = {
        "key": key,
        "value": value,
        "is_preview": is_preview,
        "is_literal": True,
    }
    status, data = client.call("POST", f"/api/v1/applications/{app_uuid}/envs", body=payload)
    if status < 300:
        return status
    # Coolify returns 422 "already exists" — update instead.
    status2, data2 = client.call("PATCH", f"/api/v1/applications/{app_uuid}/envs", body=payload)
    if status2 >= 300:
        raise SystemExit(f"Failed to set {key}: POST {status} {data!r} / PATCH {status2} {data2!r}")
    return status2


def cmd_env_set(client: CoolifyClient, args: argparse.Namespace) -> None:
    app = client.resolve_app(args.app)
    pairs = _parse_kv_pairs(args.pairs)
    if not pairs:
        raise SystemExit("No KEY=VALUE pairs given")

    for k, v in pairs.items():
        status = _upsert_env(client, app["uuid"], k, v, args.preview)
        print(f"  set {k} (HTTP {status})")

    if args.verify:
        # Read back via API. Note: this only verifies Coolify has stored it,
        # not that it propagated to the running container — that's a known
        # Coolify gotcha. If the app is redeployed, values land in-container.
        s, data = client.call("GET", f"/api/v1/applications/{app['uuid']}/envs")
        if s >= 300 or not isinstance(data, list):
            print(f"  verify: could not read envs back (HTTP {s})", file=sys.stderr)
        else:
            by_key = {e.get("key"): e.get("value") for e in data}
            bad = [k for k, v in pairs.items() if by_key.get(k) != v]
            if bad:
                print(f"  verify: MISMATCH after write: {', '.join(bad)}", file=sys.stderr)
                sys.exit(2)
            print(f"  verify: OK — {len(pairs)} key(s) match in API")
            print("  (note: container needs redeploy to see new values — use --deploy)")

    if args.deploy:
        _deploy_and_maybe_wait(client, app, wait=args.wait, force=True, timeout=args.timeout)


def cmd_env_sync(client: CoolifyClient, args: argparse.Namespace) -> None:
    app = client.resolve_app(args.app)
    vals = _parse_env_file(Path(args.file).expanduser().resolve())
    if not vals:
        raise SystemExit(f"No values parsed from {args.file}")
    if args.prefix:
        vals = {k: v for k, v in vals.items() if k.startswith(args.prefix)}
    if not vals:
        raise SystemExit(f"No keys match prefix {args.prefix!r}")
    print(f"Syncing {len(vals)} key(s) from {args.file} to {app['name']}:")
    for k, v in vals.items():
        status = _upsert_env(client, app["uuid"], k, v, args.preview)
        print(f"  set {k} (HTTP {status})")
    if args.deploy:
        _deploy_and_maybe_wait(client, app, wait=args.wait, force=True, timeout=args.timeout)


def cmd_domain_set(client: CoolifyClient, args: argparse.Namespace) -> None:
    app = client.resolve_app(args.app)
    body: dict[str, Any] = {"domains": args.url}
    if args.force_https is not None:
        body["is_force_https_enabled"] = args.force_https
    if args.instant_deploy:
        body["instant_deploy"] = True
    status, data = client.call("PATCH", f"/api/v1/applications/{app['uuid']}", body=body)
    if status >= 300:
        print(f"HTTP {status}: PATCH failed", file=sys.stderr)
        _dump_json(data)
        sys.exit(1)
    print(f"HTTP {status}: domain set to {args.url}")
    if args.deploy:
        _deploy_and_maybe_wait(client, app, wait=args.wait, force=True, timeout=args.timeout)


def cmd_deploy(client: CoolifyClient, args: argparse.Namespace) -> None:
    app = client.resolve_app(args.app)
    _deploy_and_maybe_wait(client, app, wait=args.wait, force=args.force, timeout=args.timeout)


def cmd_deploy_logs(client: CoolifyClient, args: argparse.Namespace) -> None:
    """Fetch deployment logs and surface per-finding structured error records.

    Calls GET /api/v1/deployments/{uuid}/logs (or falls back to
    GET /api/v1/deployments/{uuid} and reads an embedded logs list).

    Each log entry is returned as a structured record:
      {level, title, message, phase, line, source, raw}

    With --errors-only, only entries whose level is ``error`` or ``fatal``
    are shown.  Default (no filter) shows all entries.

    Output is a JSON array of finding records so downstream tooling (linters,
    CI parsers) can process them without text parsing.  Non-JSON output is
    also printed in human-readable form when --json is not set.
    """
    dep_uuid = args.deployment_uuid
    # Try the dedicated logs endpoint first.
    s, data = client.call("GET", f"/api/v1/deployments/{dep_uuid}/logs")
    if s >= 300:
        # Fall back to the deployment record itself, which may embed logs.
        s2, data2 = client.call("GET", f"/api/v1/deployments/{dep_uuid}")
        if s2 >= 300:
            raise SystemExit(
                f"Could not fetch logs: GET /logs HTTP {s}, GET deployment HTTP {s2}"
            )
        data = data2

    # Normalise: Coolify may return a list of log objects, a dict with a
    # ``logs`` list, or a dict with a ``data`` list.
    raw_logs: list = []
    if isinstance(data, list):
        raw_logs = data
    elif isinstance(data, dict):
        raw_logs = (
            data.get("logs")
            or data.get("data")
            or []
        )

    # Map each log entry to a structured finding record.
    findings: list[dict[str, Any]] = []
    phase_markers = {"build": "build", "push": "push", "runtime": "runtime", "start": "runtime"}
    current_phase = "unknown"
    for idx, entry in enumerate(raw_logs):
        if isinstance(entry, str):
            text = entry
            raw_entry: dict[str, Any] = {"output": text}
        elif isinstance(entry, dict):
            text = (
                entry.get("output")
                or entry.get("log")
                or entry.get("message")
                or ""
            )
            raw_entry = entry
        else:
            continue

        text_lower = text.lower()
        for marker, mapped in phase_markers.items():
            if f"[{marker}]" in text_lower or f":{marker}:" in text_lower:
                current_phase = mapped

        # Determine level from the entry itself or by heuristics on the text.
        raw_level = (
            raw_entry.get("level")
            or raw_entry.get("type")
            or raw_entry.get("severity")
            or ""
        ).lower()

        if raw_level in ("error", "fatal", "critical"):
            level = "error"
        elif raw_level in ("warn", "warning"):
            level = "warning"
        elif raw_level in ("info", "debug", "trace"):
            level = raw_level
        elif any(kw in text_lower for kw in ("error:", "fatal:", "failed:", "exception:", "traceback")):
            level = "error"
        elif any(kw in text_lower for kw in ("warn:", "warning:")):
            level = "warning"
        else:
            level = "info"

        # title: first token of the message (truncated); message: full text.
        words = text.split()
        title = words[0].rstrip(".:,;") if words else "log_entry"
        if len(title) > 48:
            title = title[:48]

        finding: dict[str, Any] = {
            "level": level,
            "title": title,
            "message": text.strip(),
            "phase": current_phase,
            "line": idx,
            "source": dep_uuid,
        }
        if args.include_raw:
            finding["raw"] = raw_entry
        findings.append(finding)

    if args.errors_only:
        findings = [f for f in findings if f["level"] in ("error", "fatal")]

    if args.json:
        _dump_json({"deployment_uuid": dep_uuid, "findings": findings})
        return

    print(f"Deployment {dep_uuid}: {len(findings)} log finding(s)")
    for f in findings:
        lvl_tag = f["level"].upper()[:5]
        print(f"  [{f['phase']:8s}] [{lvl_tag:5s}] {f['message'][:120]}")


def _parse_deploy_error(dep_record: dict) -> dict[str, Any]:
    """Extract structured error fields from a failed deployment record.

    Coolify deployment objects carry ``status_reason`` (a free-text string)
    and the logs blob may contain stage markers like ``[build]``, ``[push]``,
    ``[runtime]``.  We do a best-effort extraction so the caller gets a
    structured envelope rather than the raw blob.

    Returns a dict with keys:
      error_code   -- short token derived from status_reason (or "deploy_failed")
      phase        -- "build" | "push" | "runtime" | "unknown"
      failed_step  -- last non-empty log line before the error, or None
      hint         -- human-readable suggestion based on the phase
      raw_error    -- the original status_reason string (may be None)
    """
    raw_error: str | None = dep_record.get("status_reason") or None

    # Determine phase from the raw_error text or any ``logs`` list in the record.
    phase = "unknown"
    failed_step: str | None = None

    # Check log lines for the last stage marker seen before failure.
    logs = dep_record.get("logs") or []
    if isinstance(logs, list):
        phase_markers = {"build": "build", "push": "push", "runtime": "runtime", "start": "runtime"}
        for entry in logs:
            text = ""
            if isinstance(entry, dict):
                text = entry.get("output") or entry.get("log") or entry.get("message") or ""
            elif isinstance(entry, str):
                text = entry
            text_lower = text.lower()
            for marker, mapped in phase_markers.items():
                if f"[{marker}]" in text_lower or f":{marker}:" in text_lower:
                    phase = mapped
            if text.strip():
                failed_step = text.strip()[:200]  # cap at 200 chars

    # Fallback: infer phase from raw_error string if logs gave nothing.
    if phase == "unknown" and raw_error:
        low = raw_error.lower()
        if "build" in low:
            phase = "build"
        elif "push" in low or "registry" in low:
            phase = "push"
        elif "start" in low or "runtime" in low or "container" in low:
            phase = "runtime"

    # Derive a short error code from the first meaningful word of status_reason.
    error_code = "deploy_failed"
    if raw_error:
        # Strip punctuation, take first token, lower-case.
        token = raw_error.split()[0].lower().rstrip(".:,;") if raw_error.split() else ""
        if token and token.isascii() and len(token) <= 32:
            error_code = token

    hint_map = {
        "build": "Check Dockerfile and build args; see deployment logs for the failing step.",
        "push": "Check registry credentials and image name in Coolify app settings.",
        "runtime": "Container failed to start; inspect logs for runtime errors or missing env vars.",
        "unknown": "Check the full deployment log in the Coolify UI for details.",
    }
    hint = hint_map.get(phase, hint_map["unknown"])
    # `title` and `message` are canonical error-record fields recognised by
    # tooling that processes structured error envelopes (linters, formatters).
    # `level` is always "error" for deploy failures -- included so downstream
    # processors can filter by severity without special-casing the status field.
    return {
        "level": "error",
        "title": error_code,
        "message": hint,
        "error_code": error_code,
        "phase": phase,
        "failed_step": failed_step,
        "hint": hint,
        "raw_error": raw_error,
    }


def _wait_for_deployment(
    client: CoolifyClient,
    dep_uuid: str,
    *,
    timeout: int = WAIT_DEFAULT_TIMEOUT,
    poll_interval: int = WAIT_DEFAULT_POLL_INTERVAL,
) -> dict[str, Any]:
    """Poll a Coolify deployment until terminal state, timeout, or error.

    Streams status-change events to stderr as they happen so the caller can
    see progress without waiting for the full deployment to finish.

    Terminal states: ``finished`` (success), ``failed``, ``cancelled-by-user``,
    ``cancelled-by-system``.

    Returns a result dict:
      On success:  {status: "finished", elapsed_s, deployment}
      On failure:  {status: "failed", elapsed_s, deployment,
                    error_code, phase, failed_step, hint, raw_error,
                    _exit_nonzero: True}
      On timeout:  {status: "timeout", elapsed_s, last_state,
                    _exit_nonzero: True}
      On cancel:   {status: "cancelled", cancel_reason, elapsed_s,
                    _exit_nonzero: True}
    """
    terminal = {"finished", "failed", "cancelled-by-user", "cancelled-by-system"}
    poll_interval = max(WAIT_MIN_POLL_INTERVAL, poll_interval)
    last_state: str | None = None
    last_dep: dict[str, Any] = {}
    start = time.time()

    print("Waiting for deployment to complete...", file=sys.stderr)

    while True:
        elapsed = int(time.time() - start)

        if elapsed >= timeout:
            print(
                f"  [{elapsed:4d}s] TIMEOUT in state {last_state!r}",
                file=sys.stderr,
            )
            return {
                "status": "timeout",
                "elapsed_s": elapsed,
                "last_state": last_state,
                "deployment_uuid": dep_uuid,
                "_exit_nonzero": True,
            }

        s, d = client.call("GET", f"/api/v1/deployments/{dep_uuid}")
        if s >= 300:
            print(f"  [{elapsed:4d}s] poll error HTTP {s}", file=sys.stderr)
            time.sleep(poll_interval)
            continue

        dep_record = d if isinstance(d, dict) else {}
        state: str | None = dep_record.get("status")
        if isinstance(state, str):
            state = state.lower()

        if state != last_state:
            print(f"  [{elapsed:4d}s] {state}", file=sys.stderr)
            last_state = state
            last_dep = dep_record

        if state in terminal:
            elapsed_final = int(time.time() - start)
            if state == "finished":
                return {
                    "status": "finished",
                    "elapsed_s": elapsed_final,
                    "deployment": _slim_deployment(dep_record),
                }
            # failed or cancelled
            if state == "failed":
                # _parse_deploy_error reads the full record (incl. logs) for
                # phase/step inference but the emitted envelope uses the slim
                # projection — keeps build-output secrets out of the result.
                err_info = _parse_deploy_error(dep_record)
                return {
                    "status": "error",
                    "elapsed_s": elapsed_final,
                    "deployment": _slim_deployment(dep_record),
                    "_exit_nonzero": True,
                    **err_info,
                }
            # cancelled-by-user or cancelled-by-system
            cancel_reason = dep_record.get("status_reason") or state
            return {
                "status": "cancelled",
                "cancel_reason": cancel_reason,
                "elapsed_s": elapsed_final,
                "deployment": _slim_deployment(dep_record),
                "_exit_nonzero": True,
            }

        time.sleep(poll_interval)


def _deploy_and_maybe_wait(
    client: CoolifyClient, app: dict, *, wait: bool, force: bool, timeout: int = 600
) -> None:
    status, data = client.call(
        "GET", "/api/v1/deploy", query={"uuid": app["uuid"], "force": "true" if force else "false"}
    )
    if status >= 300:
        print(f"HTTP {status}: deploy trigger failed", file=sys.stderr)
        _dump_json(data)
        sys.exit(1)
    deployments = (data or {}).get("deployments") if isinstance(data, dict) else None
    dep_uuid = None
    if deployments:
        dep_uuid = deployments[0].get("resource_uuid") or deployments[0].get("uuid")
    print(f"HTTP {status}: deploy triggered for {app['name']} (deployment {dep_uuid or '?'})")
    if not wait or not dep_uuid:
        return

    result = _wait_for_deployment(client, dep_uuid, timeout=timeout)
    if result.get("_exit_nonzero"):
        # Emit structured error envelope to stdout so the caller can parse it.
        _dump_json(result)
        sys.exit(1)
    # Success -- emit the final state.
    _dump_json(result)


def cmd_tls_enable(client: CoolifyClient, args: argparse.Namespace) -> None:
    """Bundle: set domain, enable force-https, redeploy, smoke-test HTTPS."""
    app = client.resolve_app(args.app)
    url = args.domain
    if not url.startswith("https://"):
        raise SystemExit(f"--domain must be an https:// URL, got {url!r}")

    print(f"[1/4] Setting domain → {url}")
    s, d = client.call(
        "PATCH",
        f"/api/v1/applications/{app['uuid']}",
        body={"domains": url, "is_force_https_enabled": True},
    )
    if s >= 300:
        print(f"HTTP {s}: PATCH failed", file=sys.stderr)
        _dump_json(d)
        sys.exit(1)

    print("[2/4] Triggering deploy")
    _deploy_and_maybe_wait(client, app, wait=True, force=True, timeout=args.timeout)

    print("[3/4] Waiting for Let's Encrypt cert provisioning (up to 120s)")
    # Coolify proxies request a cert on first hit; poll the HTTPS endpoint.
    ok = False
    start = time.time()
    while time.time() - start < 120:
        try:
            req = urllib.request.Request(url, method="HEAD")
            with urllib.request.urlopen(req, timeout=10) as resp:
                if resp.status < 500:
                    ok = True
                    break
        except Exception as e:
            print(f"  retry: {e.__class__.__name__}: {e}")
        time.sleep(5)

    print(f"[4/4] HTTPS smoke test: {'OK' if ok else 'FAILED'}")
    if not ok:
        sys.exit(1)


def cmd_server_list(client: CoolifyClient, args: argparse.Namespace) -> None:
    status, data = client.call("GET", "/api/v1/servers")
    if status >= 300:
        raise SystemExit(f"GET /api/v1/servers failed: HTTP {status}: {data!r}")
    if args.json:
        _dump_json(data)
        return
    if not isinstance(data, list):
        _dump_json(data)
        return
    print(f"{len(data)} server(s):")
    for s in data:
        print(f"  {s.get('name',''):24s} {s.get('ip',''):18s} {s.get('uuid','')}")


# ─── whoami (refresh_handler target) ──────────────────────────────────────────


def cmd_whoami(args: argparse.Namespace) -> None:
    """Identity probe for `agent-plus refresh`. Read-only. No SSH, no writes.

    Source-of-truth for the COOLIFY_URL + COOLIFY_API_KEY pair the wrapper
    would use. Single GET /api/v1/servers to validate the credential and
    surface a `default_server` for the identity record. On unconfigured
    env or HTTP failure: emits `{ok: false, error, hint}` and exits 1 so
    the framework's soft-mode handler can report it as an error surface
    without blowing up.
    """
    out = whoami()
    _dump_json(out)
    if not out.get("ok"):
        # rc=0 for soft "unconfigured" (env vars missing) so the framework's
        # _run_refresh_handler treats it as a clean unconfigured surface, not
        # an error. rc=1 still flags genuine failures (HTTP/network).
        if out.get("status") == "unconfigured":
            return
        sys.exit(1)


def whoami() -> dict[str, Any]:
    url = (os.environ.get("COOLIFY_URL") or "").rstrip("/")
    key = os.environ.get("COOLIFY_API_KEY") or ""
    if not url or not key:
        missing = [k for k, v in (("COOLIFY_URL", url), ("COOLIFY_API_KEY", key)) if not v]
        return {
            "ok": False,
            "status": "unconfigured",
            "error": "unconfigured",
            "hint": f"set {', '.join(missing)} in project .env or shell env",
            "configured_keys": [k for k, v in (("COOLIFY_URL", url), ("COOLIFY_API_KEY", key)) if v],
        }
    # Single low-cost call. Stays under the 10s refresh_handler timeout.
    try:
        req = urllib.request.Request(
            f"{url}/api/v1/servers",
            headers={"Authorization": f"Bearer {key}", "Accept": "application/json"},
            method="GET",
        )
        with urllib.request.urlopen(req, timeout=8) as resp:
            raw = resp.read()
            status = resp.status
    except urllib.error.HTTPError as e:
        return {"ok": False, "error": f"HTTP {e.code} on /api/v1/servers", "hint": "check COOLIFY_API_KEY", "base_url": url}
    except (urllib.error.URLError, OSError, TimeoutError) as e:
        return {"ok": False, "error": f"network error: {e}", "hint": "check COOLIFY_URL reachability", "base_url": url}

    try:
        servers = json.loads(raw) if raw else []
    except json.JSONDecodeError:
        servers = []
    if not isinstance(servers, list):
        servers = []
    default = ""
    for s in servers:
        if isinstance(s, dict) and s.get("is_reachable") and (s.get("is_usable") is not False):
            default = s.get("name", "") or ""
            break
    if not default and servers:
        first = servers[0]
        if isinstance(first, dict):
            default = first.get("name", "") or ""
    return {
        "ok": True,
        "base_url": url,
        "default_server": default or None,
        "server_count": len(servers),
    }


# ─── argparse wiring ──────────────────────────────────────────────────────────


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="coolify-remote",
        description="Remote CLI for a Coolify PaaS deployment",
    )
    p.add_argument("--version", action="version",
                   version=f"{TOOL_NAME} {_plugin_version()}")
    p.add_argument(
        "--env-file",
        action="append",
        default=[],
        help="Additional .env file(s) to load (highest precedence). "
             "Project .env/.env.local (walked up from cwd) are auto-loaded "
             "and override shell env; --env-file overrides those in turn.",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    # app
    sp = sub.add_parser("app", help="Manage applications")
    app_sub = sp.add_subparsers(dest="app_cmd", required=True)

    al = app_sub.add_parser("list", help="List applications")
    al.add_argument("--json", action="store_true")
    al.set_defaults(func=cmd_app_list)

    ash = app_sub.add_parser("show", help="Show full JSON for one app")
    ash.add_argument("app", help="App name or UUID")
    ash.set_defaults(func=cmd_app_show)

    ax = app_sub.add_parser(
        "exec",
        help="Run a shell command inside the app's container "
             "(SSH + docker exec under the hood — no REST exec endpoint exists)",
    )
    ax.add_argument("app", help="App name or UUID")
    ax.add_argument("-t", "--tty", action="store_true", help="Allocate a TTY (for interactive tools)")
    ax.add_argument("-v", "--verbose", action="store_true", help="Print the ssh command before running")
    ax.add_argument(
        "--ssh-strict",
        action="store_true",
        help="Use ssh's default StrictHostKeyChecking behaviour (interactive prompt on first contact). "
             "Default is accept-new, which is cron-safe but trusts the host on first connection.",
    )
    ax.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        help="Command to run inside the container. Prefix with -- to separate from flags.",
    )
    ax.set_defaults(func=cmd_app_exec)

    # env
    sp = sub.add_parser("env", help="Manage application env vars")
    env_sub = sp.add_subparsers(dest="env_cmd", required=True)

    el = env_sub.add_parser("list", help="List env vars for an app")
    el.add_argument("app")
    el.add_argument("--show", action="store_true", help="Show full values (default redacts)")
    el.add_argument("--json", action="store_true")
    el.set_defaults(func=cmd_env_list)

    es = env_sub.add_parser("set", help="Set one or more env vars (upsert)")
    es.add_argument("app")
    es.add_argument("pairs", nargs="+", metavar="KEY=VALUE")
    es.add_argument("--preview", action="store_true", help="Set on preview env instead of production")
    es.add_argument("--verify", action="store_true", help="Read envs back after write and check values match")
    es.add_argument("--deploy", action="store_true", help="Redeploy after setting (required for container to see new values)")
    es.add_argument("--wait", action="store_true", help="With --deploy, block until deployment finishes")
    es.add_argument("--timeout", type=int, default=600, help="Deploy wait timeout in seconds (default 600)")
    es.set_defaults(func=cmd_env_set)

    esync = env_sub.add_parser("sync", help="Upsert env vars from a local .env file")
    esync.add_argument("app")
    esync.add_argument("file", help="Path to .env file")
    esync.add_argument("--prefix", help="Only sync keys with this prefix")
    esync.add_argument("--preview", action="store_true")
    esync.add_argument("--deploy", action="store_true")
    esync.add_argument("--wait", action="store_true")
    esync.add_argument("--timeout", type=int, default=600)
    esync.set_defaults(func=cmd_env_sync)

    # domain
    sp = sub.add_parser("domain", help="Manage app domains")
    dom_sub = sp.add_subparsers(dest="domain_cmd", required=True)

    ds = dom_sub.add_parser("set", help="Set the domain(s) for an app")
    ds.add_argument("app")
    ds.add_argument("url", help='e.g. "https://myapp.example.com" (comma-separate multiple)')
    ds.add_argument(
        "--force-https",
        dest="force_https",
        action=argparse.BooleanOptionalAction,
        default=None,
        help="Enable/disable Coolify's is_force_https_enabled",
    )
    ds.add_argument("--instant-deploy", action="store_true")
    ds.add_argument("--deploy", action="store_true", help="Trigger a deploy after setting")
    ds.add_argument("--wait", action="store_true")
    ds.add_argument("--timeout", type=int, default=600)
    ds.set_defaults(func=cmd_domain_set)

    # tls
    sp = sub.add_parser("tls", help="TLS/HTTPS convenience")
    tls_sub = sp.add_subparsers(dest="tls_cmd", required=True)
    te = tls_sub.add_parser(
        "enable",
        help="Set domain + force_https, redeploy, wait for cert, smoke-test HTTPS",
    )
    te.add_argument("app")
    te.add_argument("--domain", required=True, help='Full https:// URL')
    te.add_argument("--timeout", type=int, default=600)
    te.set_defaults(func=cmd_tls_enable)

    # deploy
    sp = sub.add_parser("deploy", help="Trigger a deploy")
    sp.add_argument("app")
    sp.add_argument("--force", action="store_true", default=True, help="Force rebuild (default true)")
    sp.add_argument("--no-force", dest="force", action="store_false")
    sp.add_argument("--wait", action="store_true", help="Block until deployment finishes")
    sp.add_argument("--timeout", type=int, default=600)
    sp.set_defaults(func=cmd_deploy)

    # deployment — inspect existing deployments
    dep_top = sub.add_parser("deployment", help="Inspect existing deployments")
    dep_sub = dep_top.add_subparsers(dest="deployment_cmd", required=True)

    # deployment logs <uuid>
    dl = dep_sub.add_parser(
        "logs",
        help="Fetch structured per-finding log records for a deployment UUID",
    )
    dl.add_argument(
        "deployment_uuid",
        help="Deployment UUID (from `deploy <app>` output or `app show` last deployment)",
    )
    dl.add_argument(
        "--errors-only",
        action="store_true",
        help="Show only error/fatal level findings",
    )
    dl.add_argument(
        "--include-raw",
        action="store_true",
        help="Include the raw log entry object in each finding",
    )
    dl.add_argument("--json", action="store_true", help="Emit JSON array of findings")
    dl.set_defaults(func=cmd_deploy_logs)

    # server
    sp = sub.add_parser("server", help="Manage servers")
    srv_sub = sp.add_subparsers(dest="server_cmd", required=True)
    sl = srv_sub.add_parser("list", help="List servers")
    sl.add_argument("--json", action="store_true")
    sl.set_defaults(func=cmd_server_list)

    # whoami — refresh_handler target. No client construction (would die on
    # missing env); env probe lives inside cmd_whoami so unconfigured exits
    # cleanly with a soft error envelope.
    wh = sub.add_parser(
        "whoami",
        help="emit identity (base_url, default_server, server_count) for `agent-plus refresh`",
    )
    wh.add_argument(
        "--json",
        action="store_true",
        help="emit JSON (default; flag accepted for explicitness)",
    )
    wh.set_defaults(func=cmd_whoami, needs_client=False)

    return p


def main() -> None:
    args = build_parser().parse_args()
    _autoload_env_files(args.env_file)
    if getattr(args, "needs_client", True):
        client = CoolifyClient()
        args.func(client, args)
    else:
        args.func(args)


if __name__ == "__main__":
    main()
