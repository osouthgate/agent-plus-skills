{
  "name": "vercel-remote",
  "description": "Read-first wrapper around the Vercel REST API — one-call project overviews (deployments, domains, env NAMES-only), name-resolved projects, --wait on async flows, --json on lists. Zero env-var-value leakage.",
  "version": "0.4.0",
  "author": {
    "name": "Oliver Southgate",
    "url": "https://github.com/osouthgate"
  },
  "homepage": "https://github.com/osouthgate/agent-plus-skills",
  "repository": "https://github.com/osouthgate/agent-plus-skills",
  "license": "MIT",
  "keywords": [
    "vercel",
    "devops",
    "observability",
    "deploy",
    "deployments",
    "incident-triage"
  ],
  "agent_plus_version": ">=0.7",
  "refresh_handler": {
    "command": "vercel-remote whoami --json",
    "timeout_seconds": 10,
    "identity_keys": ["username", "team"],
    "failure_mode": "soft"
  }
}
