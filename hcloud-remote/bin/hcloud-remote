#!/usr/bin/env python3
"""hcloud-remote — minimal CLI for Hetzner Cloud day-to-day ops.

Scope is deliberately narrow: list/show servers, reboot, snapshot, ssh.
Nothing for volumes, networks, load balancers, firewalls, or floating IPs —
Terraform owns those if you ever need them.

Configuration (highest precedence first):
  1. --env-file <path>
  2. ./.env.local, ./.env    (walked up from cwd)
  3. Shell environment        (including Claude Code settings)

Project .env files WIN over the shell.

Env vars:
  HCLOUD_TOKEN   Hetzner Cloud API token (Console → Security → API tokens)

Python 3.9+, stdlib only.
"""

from __future__ import annotations

import argparse
import functools
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

API_BASE = "https://api.hetzner.cloud/v1"

# Action-wait constants — snapshots can take 5+ minutes on large disks.
WAIT_DEFAULT_TIMEOUT = 600
WAIT_DEFAULT_POLL_INTERVAL = 5
WAIT_MIN_POLL_INTERVAL = 2


def _is_int(s: str) -> bool:
    """Return True if *s* is a non-empty string of ASCII digits."""
    return bool(s) and s.isdigit()

# ─── tool identity ────────────────────────────────────────────────────────────
# Every JSON payload this tool emits carries a top-level `tool: {name, version}`
# field so agents can self-diagnose version drift from the output alone — no
# extra subprocess call needed. Version is read from the plugin manifest at
# runtime so bumping plugin.json automatically flows through here.

TOOL_NAME = "hcloud-remote"


@functools.lru_cache(maxsize=1)
def _plugin_version() -> str:
    """Read the plugin version from `.claude-plugin/plugin.json` relative to
    this file. Returns 'unknown' on any error — never raises."""
    try:
        manifest = Path(__file__).resolve().parent.parent / ".claude-plugin" / "plugin.json"
        data = json.loads(manifest.read_text(encoding="utf-8"))
        return str(data.get("version", "unknown"))
    except (OSError, json.JSONDecodeError):
        return "unknown"


def _tool_meta() -> dict[str, str]:
    return {"name": TOOL_NAME, "version": _plugin_version()}


def _with_tool_meta(payload: Any) -> Any:
    """Inject `tool: {name, version}` at the top of a dict payload. Pass-through
    for non-dict payloads (list, str, None) so single-value responses stay the
    shape they were."""
    if isinstance(payload, dict) and "tool" not in payload:
        return {"tool": _tool_meta(), **payload}
    return payload

# ─── .env autoloading ─────────────────────────────────────────────────────────

_ENV_FILENAMES = (".env.local", ".env")
_ENV_PREFIXES = ("HCLOUD_", "HETZNER_")


def _parse_env_file(path: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    try:
        text = path.read_text(encoding="utf-8")
    except Exception:
        return out
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export ") :].lstrip()
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in ("'", '"'):
            v = v[1:-1]
        if k:
            out[k] = v
    return out


def _autoload_env_files(extra: list[str] | None = None) -> list[Path]:
    candidates: list[Path] = []
    seen: set[Path] = set()

    def _push(p: Path) -> None:
        p = p.expanduser().resolve()
        if p in seen or not p.is_file():
            return
        seen.add(p)
        candidates.append(p)

    for f in extra or []:
        _push(Path(f))

    cwd = Path.cwd().resolve()
    for parent in (cwd, *cwd.parents):
        before = len(candidates)
        for name in _ENV_FILENAMES:
            _push(parent / name)
        if len(candidates) > before:
            break

    loaded: list[Path] = []
    for p in reversed(candidates):
        vals = _parse_env_file(p)
        any_taken = False
        for k, v in vals.items():
            if not k.startswith(_ENV_PREFIXES):
                continue
            os.environ[k] = v
            any_taken = True
        if any_taken:
            loaded.append(p)
    return loaded


def _suggest_env_setup(missing: str) -> str:
    cwd = Path.cwd()
    return (
        f"{missing}\n\n"
        "Set in whichever is most convenient — project files win over shell env:\n\n"
        f"  Project-level (preferred):  {cwd / '.env'}\n"
        "    # .env\n"
        "    HCLOUD_TOKEN=...\n\n"
        "  Global (Claude Code settings):\n"
        "    ~/.claude/settings.json → \"env\": { \"HCLOUD_TOKEN\": \"...\" }\n"
        "    (or export it in your shell profile)\n\n"
        "Generate a token in Hetzner Console → Security → API tokens (read/write)."
    )


# ─── transport ────────────────────────────────────────────────────────────────


class HCloudClient:
    def __init__(self) -> None:
        token = os.environ.get("HCLOUD_TOKEN", "")
        if not token:
            raise SystemExit(_suggest_env_setup("HCLOUD_TOKEN is not set."))
        self.token = token

    def call(
        self,
        method: str,
        path: str,
        body: Any = None,
        *,
        query: dict[str, Any] | None = None,
        timeout: float = 30.0,
    ) -> tuple[int, Any]:
        url = API_BASE + path
        if query:
            url += "?" + urllib.parse.urlencode({k: v for k, v in query.items() if v is not None})
        headers = {
            "Authorization": f"Bearer {self.token}",
            "Accept": "application/json",
        }
        data: bytes | None = None
        if body is not None:
            data = json.dumps(body).encode()
            headers["Content-Type"] = "application/json"
        req = urllib.request.Request(url, data=data, headers=headers, method=method)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                raw = resp.read()
                status = resp.status
        except urllib.error.HTTPError as e:
            raw = e.read()
            status = e.code
        try:
            parsed = json.loads(raw) if raw else None
        except json.JSONDecodeError:
            parsed = raw
        return status, parsed

    def _servers(self) -> list[dict]:
        status, data = self.call("GET", "/servers", query={"per_page": 50})
        if status >= 300 or not isinstance(data, dict):
            raise SystemExit(f"GET /servers failed: HTTP {status}: {data!r}")
        return data.get("servers", [])

    def resolve_server(self, ident: str) -> dict:
        servers = self._servers()
        # Numeric id
        if ident.isdigit():
            for s in servers:
                if str(s.get("id")) == ident:
                    return s
        # Name
        for s in servers:
            if s.get("name") == ident:
                return s
        names = ", ".join(sorted(s.get("name", "?") for s in servers)) or "(none)"
        raise SystemExit(f"No server matching {ident!r}. Known servers: {names}")

    def resolve_image(self, ident: str) -> dict:
        """Resolve an image by numeric id or name.

        Accepts a numeric id string or a name string. Uses Hetzner's
        ``?name=`` filter for name lookups (server-side filter, single result).
        Returns the image dict or raises SystemExit with known names listed.

        Note: Hetzner Cloud has no separate project concept -- the API token
        is already scoped to exactly one project. There is nothing to resolve.
        """
        if _is_int(ident):
            status, data = self.call("GET", f"/images/{ident}")
            if status == 200 and isinstance(data, dict):
                img = data.get("image")
                if img:
                    return img
            raise SystemExit(f"No image with id {ident!r}")
        # Name lookup -- Hetzner supports ?name= filter on /images
        status, data = self.call("GET", "/images", query={"name": ident})
        if status == 200 and isinstance(data, dict):
            images = data.get("images", [])
            if images:
                return images[0]
        # Fallback: list all and show known names for the error message
        status2, data2 = self.call("GET", "/images", query={"per_page": 50})
        known: list[str] = []
        if status2 == 200 and isinstance(data2, dict):
            known = sorted(
                i.get("name") or i.get("description") or str(i.get("id", ""))
                for i in data2.get("images", [])
            )
        names = ", ".join(known) or "(none)"
        raise SystemExit(f"No image matching {ident!r}. Known images: {names}")

    def wait_action(
        self,
        action_id: int,
        *,
        timeout: int,
        poll_interval: int,
    ) -> dict[str, Any]:
        """Poll GET /actions/{action_id} until done, timeout, or error.

        Hetzner action statuses: ``running`` (keep polling), ``success``
        (done, ok), ``error`` (done, exit non-zero).

        Returns a dict with at minimum ``{status, elapsed_s}``.
        On timeout: ``{status: "timeout", last_state, elapsed_s, _exit_nonzero: True}``.
        On action error: ``{status: "error", error_code, error_message, elapsed_s, _exit_nonzero: True}``.
        On success: ``{status: "success", action, elapsed_s}``.
        """
        poll = max(WAIT_MIN_POLL_INTERVAL, poll_interval)
        start = time.monotonic()
        last: dict[str, Any] = {}
        while True:
            elapsed = time.monotonic() - start
            if elapsed >= timeout:
                return {
                    "status": "timeout",
                    "last_state": last or None,
                    "elapsed_s": int(elapsed),
                    "action_id": action_id,
                    "_exit_nonzero": True,
                }
            try:
                status, data = self.call("GET", f"/actions/{action_id}")
            except Exception as exc:
                return {
                    "status": "poll_error",
                    "error": str(exc),
                    "action_id": action_id,
                    "_exit_nonzero": True,
                }
            if status >= 300 or not isinstance(data, dict):
                return {
                    "status": "poll_error",
                    "error": f"HTTP {status}",
                    "action_id": action_id,
                    "_exit_nonzero": True,
                }
            action = data.get("action") or {}
            last = action
            action_status = action.get("status")
            if action_status == "success":
                return {
                    "status": "success",
                    "action": action,
                    "elapsed_s": int(time.monotonic() - start),
                }
            if action_status == "error":
                err = action.get("error") or {}
                return {
                    "status": "error",
                    "error_code": err.get("code"),
                    "error_message": err.get("message"),
                    "action": action,
                    "elapsed_s": int(time.monotonic() - start),
                    "_exit_nonzero": True,
                }
            # Still running -- sleep and poll again
            time.sleep(poll)


# ─── pretty printers ──────────────────────────────────────────────────────────


def _dump_json(obj: Any) -> None:
    wrapped = _with_tool_meta(obj)
    # sort_keys=False so the injected `tool` field stays pinned to the top of
    # dict payloads; non-dict payloads (lists, etc.) pass through unchanged.
    json.dump(wrapped, sys.stdout, indent=2, sort_keys=False, default=str)
    sys.stdout.write("\n")


def _server_ips(s: dict) -> tuple[str, str]:
    pub = s.get("public_net") or {}
    v4 = (pub.get("ipv4") or {}).get("ip") or "-"
    v6 = (pub.get("ipv6") or {}).get("ip") or "-"
    return v4, v6


# ─── subcommands ──────────────────────────────────────────────────────────────


def cmd_server_list(client: HCloudClient, args: argparse.Namespace) -> None:
    servers = client._servers()
    if args.json:
        _dump_json(servers)
        return
    print(f"{len(servers)} server(s):")
    print(f"  {'name':20s} {'status':10s} {'type':12s} {'ipv4':18s} ipv6")
    for s in sorted(servers, key=lambda x: x.get("name", "")):
        v4, v6 = _server_ips(s)
        stype = ((s.get("server_type") or {}).get("name")) or "?"
        print(f"  {s.get('name',''):20s} {s.get('status',''):10s} {stype:12s} {v4:18s} {v6}")


def cmd_server_show(client: HCloudClient, args: argparse.Namespace) -> None:
    server = client.resolve_server(args.server)
    if args.json:
        _dump_json(server)
        return
    v4, v6 = _server_ips(server)
    dc = (server.get("datacenter") or {}).get("name") or "?"
    loc = ((server.get("datacenter") or {}).get("location") or {}).get("name") or "?"
    stype = (server.get("server_type") or {}).get("name") or "?"
    image = (server.get("image") or {}).get("name") or (server.get("image") or {}).get("description") or "?"
    print(f"name:     {server.get('name')}")
    print(f"id:       {server.get('id')}")
    print(f"status:   {server.get('status')}")
    print(f"type:     {stype}")
    print(f"image:    {image}")
    print(f"location: {loc} ({dc})")
    print(f"ipv4:     {v4}")
    print(f"ipv6:     {v6}")
    print(f"created:  {server.get('created')}")


def cmd_server_reboot(client: HCloudClient, args: argparse.Namespace) -> None:
    server = client.resolve_server(args.server)
    if not args.yes:
        resp = input(f"Reboot server {server['name']!r} (id {server['id']})? [y/N] ")
        if resp.strip().lower() != "y":
            print("aborted")
            return
    status, data = client.call("POST", f"/servers/{server['id']}/actions/reboot")
    if status >= 300:
        print(f"HTTP {status}: reboot failed", file=sys.stderr)
        _dump_json(data)
        sys.exit(1)
    action = (data or {}).get("action") or {}
    print(f"HTTP {status}: reboot queued (action {action.get('id')}, status {action.get('status')})")
    if args.wait:
        action_id = action.get("id")
        if not action_id:
            print("Warning: no action id returned; cannot wait", file=sys.stderr)
            return
        print(f"Waiting for action {action_id} (timeout {args.timeout}s) ...")
        result = client.wait_action(
            action_id,
            timeout=args.timeout,
            poll_interval=args.poll_interval,
        )
        _dump_json(result)
        if result.get("_exit_nonzero"):
            sys.exit(1)


def cmd_snapshot_create(client: HCloudClient, args: argparse.Namespace) -> None:
    server = client.resolve_server(args.server)
    body: dict[str, Any] = {"type": "snapshot"}
    if args.description:
        body["description"] = args.description
    status, data = client.call(
        "POST", f"/servers/{server['id']}/actions/create_image", body=body
    )
    if status >= 300:
        print(f"HTTP {status}: snapshot failed", file=sys.stderr)
        _dump_json(data)
        sys.exit(1)
    image = (data or {}).get("image") or {}
    action = (data or {}).get("action") or {}
    print(f"HTTP {status}: snapshot queued")
    print(f"  image id:    {image.get('id')}")
    print(f"  description: {image.get('description') or args.description or '-'}")
    print(f"  action:      {action.get('id')} ({action.get('status')})")
    if not args.wait:
        print("  (snapshot runs in background; use `hcloud-remote snapshot list` to check)")
    else:
        action_id = action.get("id")
        if not action_id:
            print("Warning: no action id returned; cannot wait", file=sys.stderr)
            return
        print(f"Waiting for action {action_id} (timeout {args.timeout}s) ...")
        result = client.wait_action(
            action_id,
            timeout=args.timeout,
            poll_interval=args.poll_interval,
        )
        _dump_json(result)
        if result.get("_exit_nonzero"):
            sys.exit(1)


def cmd_snapshot_list(client: HCloudClient, args: argparse.Namespace) -> None:
    query: dict[str, Any] = {"type": "snapshot", "per_page": 50}
    if args.server:
        server = client.resolve_server(args.server)
        # Hetzner filters snapshots by `bound_to` (the server id) — but only
        # snapshots currently attached. Use the broader list and filter client-side.
        status, data = client.call("GET", "/images", query=query)
        if status >= 300 or not isinstance(data, dict):
            raise SystemExit(f"GET /images failed: HTTP {status}: {data!r}")
        images = [
            i for i in data.get("images", [])
            if (i.get("created_from") or {}).get("id") == server["id"]
            or i.get("bound_to") == server["id"]
        ]
    else:
        status, data = client.call("GET", "/images", query=query)
        if status >= 300 or not isinstance(data, dict):
            raise SystemExit(f"GET /images failed: HTTP {status}: {data!r}")
        images = data.get("images", [])

    if args.json:
        _dump_json(images)
        return
    print(f"{len(images)} snapshot(s):")
    print(f"  {'id':12s} {'created':22s} {'size-gb':8s} from")
    for i in sorted(images, key=lambda x: x.get("created", ""), reverse=True):
        cf = (i.get("created_from") or {}).get("name") or "-"
        size = i.get("image_size") or i.get("disk_size") or 0
        desc = i.get("description") or ""
        print(f"  {str(i.get('id','')):12s} {str(i.get('created','')):22s} {size!s:8s} {cf} — {desc}")


def cmd_whoami(args: argparse.Namespace) -> None:
    """Identity probe for `agent-plus refresh`. Read-only.

    Single GET /servers — same call `server list` makes — so it stays under
    the 10s timeout and validates that HCLOUD_TOKEN actually authenticates.
    Returns `token_label` (the env-var name; the token value never leaks
    out) plus a `default_server` (first by name) and total `server_count`.
    Hetzner exposes GET /tokens for label introspection, but only on
    project-scoped tokens with extra perms — we keep this probe single-call.
    """
    out = whoami()
    _dump_json(out)
    if not out.get("ok"):
        # rc=0 for soft "unconfigured" (env vars missing) so the framework's
        # _run_refresh_handler treats it as a clean unconfigured surface, not
        # an error. rc=1 still flags genuine failures (HTTP/network).
        if out.get("status") == "unconfigured":
            return
        sys.exit(1)


def whoami() -> dict[str, Any]:
    token = os.environ.get("HCLOUD_TOKEN") or ""
    if not token:
        return {
            "ok": False,
            "status": "unconfigured",
            "error": "unconfigured",
            "hint": "set HCLOUD_TOKEN in project .env or shell env",
            "configured_keys": [],
        }
    try:
        req = urllib.request.Request(
            f"{API_BASE}/servers?per_page=50",
            headers={"Authorization": f"Bearer {token}", "Accept": "application/json"},
            method="GET",
        )
        with urllib.request.urlopen(req, timeout=8) as resp:
            raw = resp.read()
    except urllib.error.HTTPError as e:
        return {"ok": False, "error": f"HTTP {e.code} on /servers", "hint": "check HCLOUD_TOKEN", "token_label": "HCLOUD_TOKEN"}
    except (urllib.error.URLError, OSError, TimeoutError) as e:
        return {"ok": False, "error": f"network error: {e}", "hint": "check api.hetzner.cloud reachability", "token_label": "HCLOUD_TOKEN"}

    try:
        data = json.loads(raw) if raw else {}
    except json.JSONDecodeError:
        data = {}
    servers = data.get("servers") if isinstance(data, dict) else []
    if not isinstance(servers, list):
        servers = []
    names = sorted(s.get("name", "") for s in servers if isinstance(s, dict) and s.get("name"))
    return {
        "ok": True,
        "token_label": "HCLOUD_TOKEN",
        "server_count": len(servers),
        "default_server": names[0] if names else None,
    }


def cmd_ssh(client: HCloudClient, args: argparse.Namespace) -> None:
    server = client.resolve_server(args.server)
    v4, _ = _server_ips(server)
    if v4 == "-":
        raise SystemExit(f"Server {server['name']!r} has no public IPv4")
    target = f"{args.user}@{v4}"
    cmd = ["ssh", target, *args.ssh_args]
    print(f"→ {' '.join(cmd)}", file=sys.stderr)
    # Replace this process with ssh so Ctrl-C etc. behave correctly.
    try:
        if os.name == "nt":
            # os.execvp on Windows doesn't handle PATH lookup for .exe reliably
            # when invoked from the bash shim; subprocess + exit code is fine.
            sys.exit(subprocess.call(cmd))
        else:
            os.execvp("ssh", cmd)
    except FileNotFoundError:
        raise SystemExit("ssh not found on PATH")


# ─── argparse wiring ──────────────────────────────────────────────────────────


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="hcloud-remote",
        description="Minimal CLI for Hetzner Cloud day-to-day ops",
    )
    p.add_argument("--version", action="version",
                   version=f"{TOOL_NAME} {_plugin_version()}")
    p.add_argument(
        "--env-file",
        action="append",
        default=[],
        help="Additional .env file(s) to load (highest precedence).",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    # server
    sp = sub.add_parser("server", help="Manage servers")
    srv_sub = sp.add_subparsers(dest="server_cmd", required=True)

    sl = srv_sub.add_parser("list", help="List servers")
    sl.add_argument("--json", action="store_true")
    sl.set_defaults(func=cmd_server_list)

    ss = srv_sub.add_parser("show", help="Show one server (name or id)")
    ss.add_argument("server")
    ss.add_argument("--json", action="store_true")
    ss.set_defaults(func=cmd_server_show)

    sr = srv_sub.add_parser("reboot", help="Soft-reboot a server")
    sr.add_argument("server")
    sr.add_argument("-y", "--yes", action="store_true", help="Skip confirmation")
    sr.add_argument("--wait", action="store_true", help="Block until reboot action completes")
    sr.add_argument("--timeout", type=int, default=WAIT_DEFAULT_TIMEOUT,
                    help=f"Max seconds to wait (default: {WAIT_DEFAULT_TIMEOUT})")
    sr.add_argument("--poll-interval", type=int, default=WAIT_DEFAULT_POLL_INTERVAL,
                    help=f"Poll interval in seconds (default: {WAIT_DEFAULT_POLL_INTERVAL})")
    sr.set_defaults(func=cmd_server_reboot)

    # snapshot
    sp = sub.add_parser("snapshot", help="Manage snapshots")
    snap_sub = sp.add_subparsers(dest="snapshot_cmd", required=True)

    sc = snap_sub.add_parser("create", help="Create a snapshot of a server")
    sc.add_argument("server")
    sc.add_argument("--description", help="Snapshot description (optional)")
    sc.add_argument("--wait", action="store_true", help="Block until snapshot action completes")
    sc.add_argument("--timeout", type=int, default=WAIT_DEFAULT_TIMEOUT,
                    help=f"Max seconds to wait (default: {WAIT_DEFAULT_TIMEOUT})")
    sc.add_argument("--poll-interval", type=int, default=WAIT_DEFAULT_POLL_INTERVAL,
                    help=f"Poll interval in seconds (default: {WAIT_DEFAULT_POLL_INTERVAL})")
    sc.set_defaults(func=cmd_snapshot_create)

    sls = snap_sub.add_parser("list", help="List snapshots")
    sls.add_argument("--server", help="Filter to snapshots created from this server")
    sls.add_argument("--json", action="store_true")
    sls.set_defaults(func=cmd_snapshot_list)

    # ssh
    sh = sub.add_parser("ssh", help="SSH to a server by name (resolves IPv4)")
    sh.add_argument("server")
    sh.add_argument("--user", default="root", help="SSH user (default: root)")
    sh.add_argument("ssh_args", nargs=argparse.REMAINDER, help="Extra args passed to ssh")
    sh.set_defaults(func=cmd_ssh)

    # whoami — refresh_handler target.
    wh = sub.add_parser(
        "whoami",
        help="emit identity (token_label, default_server, server_count) for `agent-plus refresh`",
    )
    wh.add_argument(
        "--json",
        action="store_true",
        help="emit JSON (default; flag accepted for explicitness)",
    )
    wh.set_defaults(func=cmd_whoami, needs_client=False)

    return p


def main() -> None:
    args = build_parser().parse_args()
    _autoload_env_files(args.env_file)
    if getattr(args, "needs_client", True):
        client = HCloudClient()
        args.func(client, args)
    else:
        args.func(args)


if __name__ == "__main__":
    main()
