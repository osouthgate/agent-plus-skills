{
  "name": "supabase-remote",
  "description": "Remote CLI for day-to-day Supabase project ops — project list/resolve, SQL exec with JSON-envelope stripping and post-run row verification, RLS audit, TypeScript gen-types. Wraps the Management API + `supabase` CLI.",
  "version": "0.4.0",
  "author": {
    "name": "Oliver Southgate",
    "url": "https://github.com/osouthgate"
  },
  "homepage": "https://github.com/osouthgate/agent-plus-skills",
  "repository": "https://github.com/osouthgate/agent-plus-skills",
  "license": "MIT",
  "keywords": [
    "supabase",
    "postgres",
    "rls",
    "cli",
    "remote",
    "sql",
    "management-api"
  ],
  "agent_plus_version": ">=0.7",
  "refresh_handler": {
    "command": "supabase-remote whoami --json",
    "timeout_seconds": 10,
    "identity_keys": ["linked_project_ref", "projects"],
    "failure_mode": "soft"
  }
}
